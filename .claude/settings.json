      "Bash(git clean:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)",
      "Bash(git restore --staged .:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash -u:*)",
      "Bash(git stash -a:*)",
      "Bash(git stash --include-untracked:*)",
      "Bash(git stash --all:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
