# Copy to .env for local dev only. Real values come from Bitwarden.
# Production values live in the GitHub "production" environment secrets,
# restricted to the main branch — never commit real values here.

# --- AI providers (Atlas Visibility / Research environment only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Gemini via Vertex AI (D-029 — replaces AI Studio API key auth) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=   # local path to the atlas-vertex-ai service account JSON key

# --- Supabase (Atlas Visibility project — logically isolated from
#     any Hospitality Automation project/credentials) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-side only, bypasses RLS — never expose client-side

# --- Evidence Vault ---
GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_PATH=

# --- Run config ---
ATLAS_ENV=development        # development | production
SCORE_MODEL_VERSION=v1.0-RC
